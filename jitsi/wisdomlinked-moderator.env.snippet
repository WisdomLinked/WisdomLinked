# Paste these into your docker-jitsi-meet `.env` (merge with `./gen-passwords.sh` output and your domain URLs).
# Required for WisdomLinked JWT: exactly one moderator per token (`context.user.moderator`), not everyone.
#
# JWT — must match backend BE JITSI_APP_ID / JITSI_JWT_SECRET / JITSI_AUD / JITSI_ISS
ENABLE_AUTH=1
AUTH_TYPE=jwt
JWT_APP_ID=wisdomlinked
JWT_APP_SECRET=
JWT_ACCEPTED_ISSUERS=wisdomlinked
JWT_ACCEPTED_AUDIENCES=jitsi
#
# Prosody: do not auto-promote every JWT joiner to MUC owner (mod_muc_wait_for_host)
WAIT_FOR_HOST_DISABLE_AUTO_OWNERS=1
#
# Jicofo: keep Prosody JWT on, but do not use AuthenticationRoleManager (it grants every JWT user)
JICOFO_ENABLE_AUTH=0
ENABLE_MODERATOR_CHECKS=1
ENABLE_AUTO_OWNER=0
#
# Prosody contrib: apply affiliation from JWT (docker image includes `/prosody-plugins-contrib`)
# If XMPP_MUC_MODULES is already set, append:  ,token_affiliation
XMPP_MUC_MODULES=token_affiliation
#
# After edits: docker compose up -d --force-recreate prosody jicofo
