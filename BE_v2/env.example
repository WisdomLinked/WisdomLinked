# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017
DEV_DB_NAME=wisdomlinked
PROD_DB_NAME=wisdomlinked_prod

# MongoDB Test Configuration (used only when NODE_ENV=test)
EPHEMERAL_TEST_DB_NAME=wisdomlinked_test
# Required test-mode acknowledgment:
# TEST_DB_CARE_WIPED_EVERY_TEST_RUN=I_UNDERSTAND_THIS_TEST_DB_IS_WIPED_EVERY_TEST_RUN

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Server Configuration
PORT=5000
NODE_ENV=dev

# Frontend URL (for OAuth redirects)
FRONTEND_URL=http://localhost:5173

# SendGrid Email
SENDGRID_API_KEY=SG.your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@wisdomlinked.com

# S3 / Object Storage
S3_ENDPOINT=https://s3.amazonaws.com
S3_REGION=us-east-1
S3_BUCKET=wisdomlinked-uploads
S3_ACCESS_KEY=your-s3-access-key
S3_SECRET_KEY=your-s3-secret-key

# Stripe Payments
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret

# LiveKit (optional – video/audio sessions)
# LIVEKIT_API_KEY=your-livekit-api-key
# LIVEKIT_API_SECRET=your-livekit-api-secret
# LIVEKIT_URL=wss://your-livekit-host

# Admin Seed (optional – set to create default admin on first startup)
# ADMIN_DEFAULT_EMAIL=admin@wisdomlinked.com
# ADMIN_DEFAULT_PASSWORD=change-me-immediately

