{
  "name": "wisdomlinked-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/server.ts",
    "start": "bun run src/server.ts",
    "test": "NODE_ENV=test EPHEMERAL_TEST_DB_NAME=wisdomlinked_test TEST_DB_CARE_WIPED_EVERY_TEST_RUN=I_UNDERSTAND_THIS_TEST_DB_IS_WIPED_EVERY_TEST_RUN SENDGRID_API_KEY=test-sendgrid-key SENDGRID_FROM_EMAIL=test@wisdomlinked.com S3_ENDPOINT=https://s3.amazonaws.com S3_REGION=us-east-1 S3_BUCKET=test-bucket S3_ACCESS_KEY=test-access-key S3_SECRET_KEY=test-secret-key STRIPE_SECRET_KEY=sk_test_stub_key STRIPE_WEBHOOK_SECRET=whsec_test_stub_secret bun test --bail --timeout 10000 --coverage",
    "format": "prettier --write .",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0 && tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "logs": "bun run src/utils/viewLogs.ts",
    "logs:errors": "bun run src/utils/viewLogs.ts -l error",
    "metrics": "bun run src/utils/viewMetrics.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.0.0",
    "@aws-sdk/lib-storage": "^3.0.0",
    "@aws-sdk/s3-request-presigner": "^3.0.0",
    "@elysiajs/cors": "^1.4.0",
    "@sendgrid/mail": "^8.0.0",
    "argon2": "^0.31.2",
    "crypto": "^1.0.1",
    "elysia": "^1.4.19",
    "jsonwebtoken": "^9.0.3",
    "livekit-server-sdk": "^2.0.0",
    "mongoose": "^8.20.4",
    "sharp": "^0.33.0",
    "socket.io": "^4.8.0",
    "stripe": "^20.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^20.19.27",
    "@types/jsonwebtoken": "^9.0.10",
    "@typescript-eslint/eslint-plugin": "^8.50.1",
    "@typescript-eslint/parser": "^8.50.1",
    "bun-types": "latest",
    "eslint": "^9.39.2",
    "prettier": "^3.7.4",
    "prettier-plugin-organize-imports": "^4.3.0",
    "typescript-eslint": "^8.50.1"
  }
}
