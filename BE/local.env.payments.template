# Copy into BE/.env (do not commit secrets). Restart the backend after changes.
#
# Which Stripe payment records admins can see in Payment History / Overview stats.
# live = only livemode records (production default; also used when unset)
# all  = live and test (staging)
#
# Production deploy sets PAYMENTS_VISIBLE_MODE=live in deploy-prod.yml.
# Staging deploy sets PAYMENTS_VISIBLE_MODE=all in deploy-staging.yml.

PAYMENTS_VISIBLE_MODE=all
