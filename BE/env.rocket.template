# Copy these into BE/.env (do not commit real secrets).
# After edits, restart the backend (e.g. docker compose restart backend).

ROCKETCHAT_URL=https://chat.wisdomlinked.com
ROCKETCHAT_ADMIN_USER=your_rc_admin_login
ROCKETCHAT_ADMIN_PASS=your_rc_admin_password

# CRITICAL for WL Messenger (users.createToken + im.history) — NOT your personal access token from the UI.
# Rocket.Chat 8+: you choose a long random string and set it in TWO places (same value):
#   1) Rocket.Chat server env: CREATE_TOKENS_FOR_USERS_SECRET
#   2) This file / BE/.env: ROCKETCHAT_CREATE_TOKENS_SECRET
# Generate once, e.g.: openssl rand -hex 32
# RC Docker example: add to the rocketchat service in docker-compose.yml:
#   environment:
#     - CREATE_TOKENS_FOR_USERS_SECRET=paste_the_same_hex_here
# Then: docker compose up -d   (restart rocketchat)
ROCKETCHAT_CREATE_TOKENS_SECRET=

# Optional
# ROCKETCHAT_SKIP_READ_RECEIPTS=true

JITSI_DOMAIN=meet.wisdomlinked.com
# Optional but recommended for Jitsi role-enforced meetings (moderator/participant/guest):
# JITSI_JWT_SECRET=your_jitsi_shared_secret
# JITSI_APP_ID=wisdomlinked
# JITSI_AUD=jitsi
# JITSI_ISS=wisdomlinked
#
# --- Self-hosted Jitsi (docker-jitsi-meet / Prosody) — required for per-user moderator in JWT ---
# Stock Prosody `mod_muc_wait_for_host` makes every joiner with a JWT a MUC owner unless you set:
#   WAIT_FOR_HOST_DISABLE_AUTO_OWNERS=1
# in the Jitsi stack .env, then recreate/restart the prosody container. Without this, `moderator: false`
# in the token is ignored and everyone appears as moderator. Do not add `muc_allowners` to XMPP_MUC_MODULES
# unless you want that behavior. Docker-jitsi sets `JICOFO_ENABLE_AUTH` from `ENABLE_AUTH` by default, which
# makes **every JWT joiner** a moderator (`AuthenticationRoleManager`). Set `JICOFO_ENABLE_AUTH=0` on the
# Meet stack (keep `ENABLE_AUTH=1` for Prosody), add `ENABLE_MODERATOR_CHECKS=1`, then recreate jicofo.
