  "description": "Backend",
  "main": "index.js",
  "scripts": {
    "start": "tsx server.ts",
    "start-stg": "env-cmd -f .env.stg tsx watch server.ts",
    "dev": "tsx watch server.ts",
    "test": "sh -c 'node --import tsx --test --test-reporter=spec tests/*.test.ts'",
    "test:coverage": "sh -c 'c8 --reporter=text-summary --reporter=lcov --check-coverage --lines 20 --branches 20 --functions 20 --statements 20 node --import tsx --test tests/*.test.ts'"
