# Copy relevant lines into `BE/.env` for local development (this file is not loaded by Node).
# `BE/.gitignore` ignores `.env*`; this template uses a different name so it can live in git.

# --- Meeting chat: Jitsi browser tab POSTs to your API (see `jitsi/MEETING_CHAT_HOOKS.md`) ---
# If unset, the backend falls back to `FE_URL` / `FRONTEND_BASE_URL` / `PUBLIC_API_BASE`.
# MEETING_CHAT_SYNC_PUBLIC_API_BASE=http://127.0.0.1:5000
# Optional signing secret for meeting-chat JWTs (defaults to `JWT_SECRET`):
# MEETING_CHAT_SYNC_SECRET=
# MEETING_CHAT_SYNC_RL_PER_MIN=50
